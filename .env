# Token du bot : Portail développeur Discord → ton application → Bot → Reset Token
DISCORD_TOKEN=COLLE_TON_TOKEN_ICI

# ID du serveur : Discord → Paramètres → Avancés → Mode développeur, puis clic droit sur le serveur → Copier l'identifiant
GUILD_ID=COLLE_L_ID_DU_SERVEUR_ICI

# Base PostgreSQL : format postgresql://utilisateur:motdepasse@hote:5432/nom_de_la_base
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/illico
